# ==============================================================================
# PrepAI Placement Preparation Platform - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR SECURE SECRETS BEFORE DEPLOYMENT.
# DO NOT COMMIT REAL .env FILES CONTAINING ACTUAL SECRETS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Services (Gemini API)
# ------------------------------------------------------------------------------
# Required for AI Mock Interviews, Resume Analysis, Learning Paths, and Code Check.
# Obtain your API key from Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Tokens
# ------------------------------------------------------------------------------
# Strong cryptographic secret used for HMAC-SHA256 session token generation.
# Must be at least 32 characters long in production.
JWT_SECRET="your_secure_random_jwt_secret_min_32_characters_here"

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
# Port for the Node.js / Express Vite server (default: 3000).
PORT=3000

# The public base URL where this application is hosted.
# Used for callbacks, links, and API references.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Relational Database (Optional Spring Boot Backend)
# ------------------------------------------------------------------------------
# JDBC connection string for MySQL or PostgreSQL database.
DATABASE_URL="jdbc:mysql://localhost:3306/placement_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DATABASE_USERNAME="your_database_username_here"
DATABASE_PASSWORD="your_database_password_here"

# ------------------------------------------------------------------------------
# 5. SMTP Email Configuration (Optional - For Production Email OTP Dispatch)
# ------------------------------------------------------------------------------
# If left unset, the platform runs in automated simulated OTP mode for testing.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="verify@yourcampusdomain.edu"
SMTP_PASS="your_smtp_app_password_here"
SMTP_SECURE="false"
SMTP_FROM="Campus Placement Portal <verify@yourcampusdomain.edu>"

